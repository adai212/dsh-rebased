{
  "name": "dsh-rebased",
  "version": "0.0.0-dev.0",
  "description": "DSH Git plugin scaffold inspired by JetBrains Git workflows.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./core": {
      "default": "./lib/core/index.js"
    },
    "./ui-model": {
      "default": "./lib/ui-model/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "docs/**",
    "lib/**/*.js",
    "README.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "check:syntax": "node --check lib/index.js && node --check lib/core/index.js && node --check lib/core/contracts.js && node --check lib/ui-model/index.js && node --check lib/ui-model/sidebar.js",
    "check:client-syntax": "node --check lib/client.js"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "UNLICENSED"
}
